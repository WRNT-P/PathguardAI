# Copy to .env and fill in. .env is gitignored, so it never arrives by pull —
# when a name here changes, every machine has to be updated by hand.

# Google web-service keys — Places and Directions, called over HTTPS from Dart
# (places_service.dart, directions_service.dart, safe_zone_service.dart).
#
# NOT the key the map is drawn with. The GoogleMap widget is a native view and
# reads MAPS_API_KEY from android/local.properties, which Gradle bakes into
# AndroidManifest.xml at build time — nothing here ever reaches it. These used
# to be called *_GOOGLE_MAPS_API_KEY, which is why a blank map on 2026-09-08
# sent everyone to this file instead of the one that was actually broken.
#
# Restrictions differ for the same reason: a key called over HTTPS cannot carry
# an Android app restriction, so restrict these by API instead (Places API,
# Directions API) — the native map's key is the one that gets locked to
# package name + SHA-1.
ANDROID_GOOGLE_WEB_SERVICES_KEY=
IOS_GOOGLE_WEB_SERVICES_KEY=

# Backend base URL — Cloudflare Tunnel URL, changes every restart. Update here,
# not in code. Read once at startup by main.dart, so a change needs a full app
# restart, not a hot reload.
BACKEND_BASE_URL=
