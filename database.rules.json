// Realtime Database rules.
//
//   firebase deploy --only database --project pathguard-ai-2d047
//
// or paste into Firebase console -> Realtime Database -> Rules.
//
// Until this existed the database was in test mode: a bare curl against the
// database URL returned every patient's live position, every chat message and
// every trip request, to anyone at all. AUTH_ENABLED closed the FastAPI door
// and left this one open — they are two separate products and only one of them
// was ever behind the tunnel.
//
// None of this constrains the backend. firebase-admin authenticates as a
// service account, and service accounts bypass rules entirely, which is why
// live_positions can be shut to every client below and still be written.
{
  "rules": {
    // Deny by default. Every reachable path says so itself.
    ".read": false,
    ".write": false,

    // Written by the backend on GPS ingest (services/firebase.py) and read by
    // nothing in the app — the caregiver's map polls the REST API for position
    // instead. No client needs it, so the most sensitive data in the project
    // stops being reachable by clients at all. Give this a read rule only when
    // something actually reads it, and scope it to that patient's caregivers
    // when you do.
    "live_positions": {
      ".read": false,
      ".write": false
    },

    // Who may see a patient: the patient, and every caregiver linked to them
    // in patient_caregivers. Written by the backend (services/firebase.py)
    // whenever a link is made, because rules cannot reach Postgres to ask.
    //
    // Readable so an account can see its own access; never client-writable,
    // or granting yourself a family's chat would be a one-line curl.
    "access": {
      "$patient_id": {
        ".read": "auth != null && data.child(auth.uid).exists()",
        ".write": false
      }
    },

    // The room a family coordinates in — theirs alone.
    "chats": {
      "$patient_id": {
        ".read": "auth != null && root.child('access').child($patient_id).child(auth.uid).exists()",
        ".write": "auth != null && root.child('access').child($patient_id).child(auth.uid).exists()",
        "messages": {
          "$message_id": {
            ".validate": "newData.hasChildren(['text', 'sender_name'])"
          }
        }
      }
    },

    // A patient asking to go somewhere, and their caregivers' answer.
    // Same access list as the chat, for the same reason.
    "trip_requests": {
      "$patient_id": {
        ".read": "auth != null && root.child('access').child($patient_id).child(auth.uid).exists()",
        ".write": "auth != null && root.child('access').child($patient_id).child(auth.uid).exists()",
        "$request_id": {
          ".validate": "newData.hasChildren(['status'])"
        }
      }
    }
  }
}

// Before deploying this, run once against the same database:
//
//     cd backend && python -m scripts.sync_access_index
//
// It fills access/ for patients linked before the index existed. Without it
// every existing family is locked out of their own chat the moment these
// rules go live.
//
// Requests written under the old flat trip_requests/{id} shape are
// unreachable under these rules and unreadable by the current app. They were
// pending asks that nobody answered; delete the node if any are left:
//
//     firebase database:remove /trip_requests --project pathguard-ai-2d047
