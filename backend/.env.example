# PathGuard AI backend — copy to .env locally, or paste these as environment
# variables in the Railway / Render dashboard. Never commit the filled-in file.

# ── PostgreSQL (Neon) ─────────────────────────────────────────────────────────
# Neon gives you a postgresql:// URL; app/db/database.py rewrites the driver to
# asyncpg itself, so paste Neon's string as-is. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Firebase ──────────────────────────────────────────────────────────────────
# Path to the service-account JSON inside the container (gitignored — never commit
# the real file). Missing or invalid: the API still boots, only the live caregiver
# map goes dark, because PostgreSQL is the source of truth and the Firebase push
# is best-effort.
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app

# ── Auth ──────────────────────────────────────────────────────────────────────
# false (default): every endpoint is open. Patient ids are sequential integers,
# so anyone with the URL can read a patient's live position by guessing "1".
# That is the state plan D5 chose for a watched pilot behind an unshared URL,
# and the server logs a warning at startup saying so.
#
# true: every patient route needs a Firebase ID token (Authorization: Bearer),
# and a caller may only touch their own data or their own patient's.
#
# Turn it on before any real-patient data leaves the laptop. Known consequence:
# scripts/dashboard.html has no Firebase sign-in, so it stops working — run that
# process with AUTH_ENABLED=false on localhost only, never through the tunnel.
AUTH_ENABLED=false

# ── Misc ──────────────────────────────────────────────────────────────────────
DEBUG=false
